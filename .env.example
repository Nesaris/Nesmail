# Obligatoire. Chiffre les secrets stockes et signe les sessions.
#   openssl rand -hex 32
# Le changer rend illisibles les mots de passe deja enregistres.
CACHET_SECRET=

# Mot de passe de la premiere connexion. Si vide, il est genere et affiche au demarrage.
CACHET_PASSWORD=

# Second facteur, facultatif. Genere par :  node totp-setup.js
CACHET_TOTP_SECRET=

# Adresse et port publies sur l'hote. Le port interne reste 8787.
CACHET_BIND=127.0.0.1
CACHET_PORT=8787

# A mettre a 1 UNIQUEMENT pour un acces en HTTP sans TLS : le cookie de session
# circule alors en clair. A retirer des que le service est servi en HTTPS.
CACHET_INSECURE_COOKIE=
