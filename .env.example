# Clé maîtresse : dans ./secrets/socle_cle (jamais ici), créée une fois par
#   mkdir -p secrets && openssl rand -base64 32 > secrets/socle_cle && chmod 600 secrets/socle_cle
# La perdre rend illisibles les mots de passe des boîtes et les secrets TOTP.

# Adresse et port publiés sur l'hôte. Le port interne reste 8787.
CACHET_BIND=127.0.0.1
CACHET_PORT=8787

# 1 seulement sur un réseau de confiance sans HTTPS (mode dégradé, affiché partout).
SOCLE_HTTP=0
# Relais HTTPS autorisés à transmettre l'adresse du client (CIDR, virgules).
SOCLE_PROXYS=
# Adresse publique, pour les liens des alertes de sécurité par courriel.
SOCLE_URL_PUBLIQUE=
# Gamme de l'interface : soma, console, exploitation ou lavande.
SOCLE_THEME=soma

# Reprise d'une 1.0 seulement : son ancien CACHET_SECRET. À vider ensuite.
CACHET_SECRET_V1=
